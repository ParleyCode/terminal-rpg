
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build terminal-rpg",
            "type": "shell",
            "command": "mkdir -p build && g++ -std=c++17 -g -Wall -Wextra main.cpp Game.cpp -o build/terminal-rpg",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}

